<style>
    #settings-list{
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        justify-content: center;
        padding: 20px;
    }
    .settings-list-item{
        width: 100%;
        padding: 10px 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }
    .card{
        width: 100px;
        height: 100px;
        background-color: #7777;
        border-radius: 10px;
        padding: 10px;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 34px;
        font-weight: bold;
    }
    .card[data-is_active="True"]{
        outline: 3px solid var(--primary);
        color: var(--primary);
    }
</style>
    
<div id="settings-list">
    <NotificationButton />
    <LanguageButton OnClick="@ToggleLanguage" />

    @if (ShowLanguageDialog)
    {
        <LanguageDialog OnBackClick="@ToggleLanguage" />
    }
</div>

@code{
    bool ShowLanguageDialog;

    void ToggleLanguage()
    {
        ShowLanguageDialog = !ShowLanguageDialog;
    }
}