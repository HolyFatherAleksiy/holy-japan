@using System.Globalization
@using DataBaseRepository.Models
@using DataBaseRepository.Services.Interfaces
@using HolyJapan.Components.DropMenuComponent
@using MAUI.Models
@using MAUI.Services
@using MAUI.Services.Interfaces
@using Newtonsoft.Json
@using Shared

@inject ILanguageFileService _languageFile
@inject ILanguageService _languageService
@inject IUserDataService _userDataService
@inject IResizeService _resizeService

@implements IAsyncDisposable

@* <span>
    <p>@width px</p>
    <p>@height px</p>
</span> *@
<style>
    .language-container {
        height: 100%;
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding: 20px;
        box-sizing: border-box;
    }
    .language-grid {
        width: 100%;
        display: grid;
        grid-template-columns: repeat(auto-fit, 150px);
        gap: 20px;
        justify-content: center;
        align-items: start;
    }
    .language-footer {
        margin-top: auto;
        display: flex;
        flex-direction: column;
        gap: 12px;
        align-items: center;
    }
</style>

<div class="language-container">
    <div class="language-grid">
        @foreach(var item in Languages)
        {
            var active = item.IsSelected;
            <div class="card" data-is_active="@active.ToString()" @onclick="@(async () => await SelectLanguage(item))">
                @if (!item.MenuIsOppened)
                {
                    <span>@item.Language.Code</span>
                    <span>@item.Language.Icon</span>
                    @if (active)
                    {
                        <span style="position: absolute; width: 30px; height: 30px; bottom: 5px; right: 5px;">
                            <Blazicon Svg="@MdiIcon.CheckBold.WithColor("var(--primary)")"/>
                        </span>
                    }
                    <button @onclick:stopPropagation="true" @onclick="@(() => ToggleMenu(item))" class="btn-icon btn-opacity-primary" style="--s: 40px; position: absolute; top: -10px; right: -10px;">
                        <Blazicon Svg="@MdiIcon.DotsHorizontal"/>
                    </button>
                }
                else
                {
                    @if (!item.Language.IsDefault)
                    {
                    }
                    <div style="display: flex; gap: 10px">
                        <button @onclick:stopPropagation="true" @onclick="@(() => ToggleMenu(item))" class="btn-icon btn-opacity-error" style="--s: 50px;">
                            <Blazicon Svg="@MdiIcon.Close"/>
                        </button>
                        <button @onclick:stopPropagation="true" @onclick="@(() => ToggleMenu(item))" class="btn-icon btn-opacity-info" style="--s: 50px;">
                            <Blazicon Svg="@MdiIcon.Refresh"/>
                        </button>
                    </div>
                    <button @onclick:stopPropagation="true" @onclick="@(() => ToggleMenu(item))" class="btn-icon btn-opacity-secondary" style="--s: 40px; position: absolute; top: -10px; right: -10px;">
                        <Blazicon Svg="@MdiIcon.ArrowTopRightThick"/>
                    </button>
                    <span style="font-size: 18px; position: absolute; bottom: 5px; right: auto; left: auto">v: @item.Language.Version</span>
                }
            </div>
        }
    </div>

    <div class="language-footer">
        <span class="caption" style="--c: #fff; --fs: 18px;">
            *@Localisation.GetValue(InterfaceElements.ExampleText)
        </span>

        <button class="btn btn-sm btn-opacity-secondary" @onclick="@SelectFile">
            @Localisation.GetValue(InterfaceElements.AppendLanguage)
            <span class="icon" style="--w: 50px; --h: 50px; --c: #fff; --bc: #0002">
                <Blazicon Svg="@MdiIcon.Plus"/>
            </span>
        </button>
    </div>
</div>

@code{
    List<LanguageUIDTO> Languages = [];
    [Parameter] public EventCallback<string> SelectedLanguageChanged { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _resizeService.OnChanged += OnDisplayInfoChanged;
        await _resizeService.StartTracking();

        await UpdateList();
        await GetSystemLanguage();
    }
    double width = 0;
    double height = 0;

    void OnDisplayInfoChanged(WindowSize windowSize)
    {
        width = windowSize.Width;
        height = windowSize.Height;

        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        _resizeService.OnChanged -= OnDisplayInfoChanged;
    }

    void ToggleMenu(LanguageUIDTO item)
    {
        item.MenuIsOppened = !item.MenuIsOppened;
    }
    void CloseAllMenu()
    {
        Languages.ForEach(p=>p.MenuIsOppened = false);
    }
    void UnselectAll()
    {
        Languages.ForEach(p=>p.IsSelected = false);
    }
    async Task GetSystemLanguage()
    {
        async Task<LanguageUIDTO?> TrySelect(string code)
        {
            var language = Languages.FirstOrDefault(p=>p.Language.Code == code) 
                ?? throw new Exception($"{code} - {Localisation.GetValue(InterfaceElements.KeyNotFound)}");
            language.IsSelected = true;
            return language;
        }
        CultureInfo currentCulture = CultureInfo.CurrentUICulture;
        try
        {
            var userData = await _userDataService.GetData();
            _ = await TrySelect(userData.CurrentLanguageCode);
        }
        catch (KeyNotFoundException)
        {
            var language = await TrySelect(currentCulture.Name);
            await SelectLanguage(language!);
        }
        catch (Exception ex)
        {
            await Alerts.Show(Localisation.GetValue(InterfaceElements.ErrorText), ex.Message, Localisation.GetValue(InterfaceElements.CloseText));
        }
        finally
        {
            _languageService.InvokeChanges();
        }
    }



    async Task UpdateList()
    {
        try
        {
            var languages = await _languageService.GetAllData();
            Languages = languages.Select(p=> new LanguageUIDTO(p)).ToList();
        }
        catch(Exception ex)
        {
            await Alerts.Show(Localisation.GetValue(InterfaceElements.ErrorText), ex.Message, Localisation.GetValue(InterfaceElements.CloseText));
        }
    }
    async Task SelectLanguage(LanguageUIDTO item)
    {
        if (!item.IsSelected)
        {
            UnselectAll();
            item.IsSelected = true;

            var data = JsonConvert.DeserializeObject<Dictionary<InterfaceElements, string>>(item.Language.JSON) ?? Localisation.DefaultText;
            Localisation.Text = data;
            _languageService.InvokeChanges();
            await SelectedLanguageChanged.InvokeAsync(item.Language.Code);
            CloseAllMenu();
        }
    }
    async Task SelectFile()
    {
        try
        {
            var file = await _languageFile.PickJsonFile();
            var json = await _languageFile.GetJson(file);
            var data = _languageFile.SerializeLanguage(json);
            var newLanguage = await _languageService.AddAsync(data.Code, file.FileName, data.Icon, data.Version, JsonConvert.SerializeObject(data.Data));
            Languages.Add(new LanguageUIDTO(newLanguage));
            await InvokeAsync(StateHasChanged);
        }
        catch(Exception ex)
        {
            await Alerts.Show(Localisation.GetValue(InterfaceElements.ErrorText), ex.Message, Localisation.GetValue(InterfaceElements.CloseText));
        }
    }
}