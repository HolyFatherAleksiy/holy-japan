@using System.Globalization
@using DataBaseRepository.Models
@using DataBaseRepository.Services.Interfaces
@using MAUI.Services
@using MAUI.Services.Interfaces
@using Newtonsoft.Json
@using Shared

@inject ILanguageFileService _languageFile
@inject ILanguageService _languageService
@inject IUserDataService _userDataService
@inject IResizeService _resizeService

@implements IAsyncDisposable

<span>
    <p>@width px</p>
    <p>@height px</p>
</span>
@foreach(var item in Languages)
{
    var active = @IsSelected(item.Code);
    <div class="card" data-is_active="@active.ToString()" @onclick="@(async () => await SelectLanguage(item))" >
        <span>@item.Code</span>
        <span>@item.Icon</span>
        @if (active)
        {
            <span style="position: absolute; width: 30px; height: 30px; top: 0; right: 0;"><Blazicon Svg="@MdiIcon.CheckBold.WithColor("var(--primary)")"/></span>
        }
    </div>
}
<div class="card secondary" @onclick="@SelectFile">
    <Blazicon Svg="@MdiIcon.Plus.WithColor("#fff")"/>
</div>

@code{
    List<Language> Languages = [];
    bool IsSelected(string value) => value.Equals(SelectedLanguage);
    [Parameter] public string SelectedLanguage { get; set; } = "en-US";
    [Parameter] public EventCallback<string> SelectedLanguageChanged { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _resizeService.OnChanged += OnDisplayInfoChanged;
        await _resizeService.StartTracking();

        await UpdateList();
        await GetSelectedLanguage();
    }
    double width = 0;
    double height = 0;

    void OnDisplayInfoChanged(WindowSize windowSize)
    {
        width = windowSize.Width;
        height = windowSize.Height;
        
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        _resizeService.OnChanged -= OnDisplayInfoChanged;
    }

    async Task GetSelectedLanguage()
    {
        try
        {
            var userData = await _userDataService.GetData();
            SelectedLanguage = userData.CurrentLanguageCode;
        }
        catch (KeyNotFoundException kex)
        {
            CultureInfo currentCulture = CultureInfo.CurrentUICulture;
            var language = Languages.FirstOrDefault(p=>p.Code == currentCulture.Name) 
                ?? throw new Exception();
            await SelectLanguage(language);

        }
        catch (Exception ex)
        {
            SelectedLanguage = Localisation.DefaultCode;
        }
        finally
        {
            _languageService.InvokeChanges();
        }
    }



    async Task UpdateList()
    {
        try
        {
            Languages = await _languageService.GetAllData();
        }
        catch(Exception ex)
        {
            await Alerts.Show(Localisation.GetValue(InterfaceElements.ErrorText), ex.Message, Localisation.GetValue(InterfaceElements.CloseText));
        }
    }
    async Task SelectLanguage(Language language)
    {
        SelectedLanguage = language.Code;

        var data = JsonConvert.DeserializeObject<Dictionary<InterfaceElements, string>>(language.JSON) ?? Localisation.DefaultText;
        Localisation.Text = data;
        _languageService.InvokeChanges();
        await SelectedLanguageChanged.InvokeAsync(language.Code);
    }
    async Task SelectFile()
    {
        try
        {
            var file = await _languageFile.PickJsonFile();
            var json = await _languageFile.GetJson(file);
            var data = _languageFile.SerializeLanguage(json);
            var newLanguage = await _languageService.AddAsync(data.Code, file.FileName, data.Icon, data.Version, JsonConvert.SerializeObject(data.Data));
            Languages.Add(newLanguage);
            await InvokeAsync(StateHasChanged);
        }
        catch(Exception ex)
        {
            await Alerts.Show(Localisation.GetValue(InterfaceElements.ErrorText), ex.Message, Localisation.GetValue(InterfaceElements.CloseText));
        }
    }
}