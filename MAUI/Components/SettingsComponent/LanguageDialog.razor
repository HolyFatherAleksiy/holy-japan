@using Microsoft.Extensions.Logging
@inject ILogger<LanguageDialog> Logger
<style>
    .back{
        width: 100px;
        height: 100px;
        position: absolute;
        background: transparent;
        border: none;
        outline: none;
    }
    .add{
        width: 100px;
        height: 100px;
        position: absolute;
        background: transparent;
        border: none;
        outline: none;
        bottom: 0;
        right: 0;
    }
</style>
<div class="overlay">
    <button class="back" @onclick="@Back">
        <Blazicon Svg="@MdiIcon.ArrowLeft.WithColor("var(--primary)")"/>
    </button>

    <div class="dialog">
        <LanguageList />
    </div>
</div>


@code{
    [Parameter] public EventCallback OnBackClick { get; set; }


    async Task Back()
    {
        await OnBackClick.InvokeAsync();
    }
}