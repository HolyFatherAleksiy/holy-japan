@using DataBaseRepository.Services.Interfaces
@using MAUI.Services
@using Shared
@inherits LayoutComponentBase
@inject IUserDataService _userDataService
@if (HasUserData)
{
    @Body
}
else
{
    <Registration />
}

@code{
    bool HasUserData = false;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var data = await _userDataService.GetData();
            HasUserData = data != null;
        }
        catch(KeyNotFoundException kex)
        {
            HasUserData = false;
        }
        catch(Exception ex)
        {
            await Alerts.Show(Localisation.GetValue(InterfaceElements.ErrorText), ex.Message, Localisation.GetValue(InterfaceElements.CloseText));
        }
    }
}